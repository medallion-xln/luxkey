<div class="min-h-screen flex items-center justify-center bg-navy-dark py-12 px-4 sm:px-6 lg:px-8 font-inter text-champagne">
    <div class="max-w-md w-full space-y-8">
        <div>
            <h2 class="mt-6 text-center text-3xl font-medium text-champagne font-playfair">Sign in to your account</h2>
        </div>
        <div class="bg-navy bg-opacity-80 py-8 px-4 shadow-md rounded-lg sm:px-10">
            <form hx-post="/auth/login" hx-target="#response" class="space-y-6" autocomplete="off">
                <div>
                    <label for="email" class="block text-sm font-medium text-platinum">Email address</label>
                    <div class="mt-1">
                        <input id="email" name="email" type="email" autocomplete="email" required class="form-input bg-navy-light text-champagne focus:ring-gold focus:border-gold block w-full sm:text-sm rounded-md" placeholder="you@example.com" />
                    </div>
                </div>
                <div>
                    <label for="password" class="block text-sm font-medium text-platinum">Password</label>
                    <div class="mt-1">
                        <input id="password" name="password" type="password" autocomplete="current-password" required class="form-input bg-navy-light text-champagne focus:ring-gold focus:border-gold block w-full sm:text-sm rounded-md" />
                    </div>
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <input id="remember-me" name="remember-me" type="checkbox" class="form-checkbox text-gold focus:ring-gold focus:border-gold rounded" />
                        <label for="remember-me" class="ml-2 block text-sm text-champagne">Remember me</label>
                    </div>
                </div>

                <div>
                    <button type="submit" class="btn-elevated w-full">
                        Sign in
                    </button>
                </div>
            </form>

            <div id="response">
                <% if (messages.error) { %>
                    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
                        <strong class="font-bold">Error:</strong> <%= messages.error %>
                    </div>
                <% } %>
            </div>

            <div class="text-center">
                <p class="text-sm text-platinum">
                    Don't have an account?
                    <a href="/auth/register" class="font-medium text-gold hover:text-gold-light">Register here</a>
                </p>
            </div>
        </div>
    </div>
</div>