<div class="text-center mb-12">
    <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight lg:text-5xl mb-4">
        Discover Luxury Real Estate
    </h1>
    <p class="text-xl text-muted-foreground mb-8">
        Find your dream property in the world's most exclusive locations
    </p>
    
    <div class="max-w-2xl mx-auto">
        <form hx-get="/api/listings" hx-target="#listings" class="flex gap-4">
            <input type="text" 
                   name="search" 
                   placeholder="Search by location, price, or features..." 
                   class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 flex-1">
            <button type="submit" 
                    class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow hover:bg-primary/90 h-9 px-4 py-2">
                Search
            </button>
        </form>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="listings">
    <% if (listings && listings.length > 0) { %>
        <% for (let i = 0; i < listings.length; i++) { %>
            <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
                <img src="<%= listings[i].image %>" alt="<%= listings[i].title %>" class="w-full h-48 object-cover rounded-t-lg">
                <div class="p-6">
                    <h3 class="text-xl font-semibold mb-2"><%= listings[i].title %></h3>
                    <p class="text-sm text-muted-foreground mb-4"><%= listings[i].location %></p>
                    <div class="flex justify-between items-center">
                        <span class="text-2xl font-bold">$<%= listings[i].price.toLocaleString() %></span>
                        <a href="/listings/<%= listings[i].id %>" 
                           class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        <% } %>
    <% } else { %>
        <div class="col-span-full text-center py-12">
            <p class="text-muted-foreground">No listings available at the moment.</p>
        </div>
    <% } %>
</div>

<div class="mt-12 text-center">
    <h2 class="scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0 mb-6">Why Choose LuxKey?</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
            <h3 class="scroll-m-20 text-xl font-semibold tracking-tight mb-2">Exclusive Listings</h3>
            <p class="text-sm text-muted-foreground">Access to premium properties not available elsewhere</p>
        </div>
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
            <h3 class="scroll-m-20 text-xl font-semibold tracking-tight mb-2">Expert Guidance</h3>
            <p class="text-sm text-muted-foreground">Professional support throughout your property journey</p>
        </div>
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-6">
            <h3 class="scroll-m-20 text-xl font-semibold tracking-tight mb-2">Global Network</h3>
            <p class="text-sm text-muted-foreground">Connections to luxury properties worldwide</p>
        </div>
    </div> 